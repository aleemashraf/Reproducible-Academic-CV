@unpublished{ashraf_teacher-attributed_2026,
	type = {Under review in {Social} {Psychology} of {Education}},
	title = {Do {Teacher}-{Attributed} {Informational} {Cues} {Influence} {Students}' {Moral} {Judgments}? {An} {Experimental} {Study} of {Conformity}},
	abstract = {Higher education seeks to cultivate students’ intellectual autonomy, yet teachers carry the role of epistemic authority. This creates a potential tension: can teacher-attributed information shape students’ judgments even when teachers are not physically present and do not directly express their views? Previous research has demonstrated that moral judgments are susceptible to social influence on, less is known about whether passive moral judgments attributed to teachers can exert such influence in the absence of direct interpersonal interaction. To address this question, 65 first-year university students in Pakistan were randomly assigned to a teacher-cue (n = 35) or control group (n = 30). Participants evaluated moral dilemmas either alongside printed aggregate judgments attributed to teachers or without such cues. An ANCOVA controlling for prior academic achievement, age, and gender indicated significantly greater alignment with the teacher-attributed judgments in the experimental group than in the control group, F(1,59) = 40.82, p {\textless}.001, ω2 = 0.37. Notably, the teacher-attributed judgments were positioned in an atypical and morally objectionable direction. These findings suggest that teacher-attributed informational cues can shape students’ moral judgments even without direct teacher presence, while leaving questions open for underlying psychological processes. The findings highlight an important boundary condition for understanding educational authority and students’ intellectual autonomy.},
	author = {Ashraf, Aleem and Asif, Afifa and Farooqui, Areeba and Rizwan, Doreen},
	year = {2026},
}

@unpublished{ashraf_control-_2026,
	address = {Karachi},
	type = {Manuscript submitted for publication in {Educational} {Research} and {Evaluation}},
	title = {Control- and {Value}-{Related} {Appraisals} to {Critical}-{Thinking} {Strategy} {Use}: {Differentiated} {Indirect} {Pathways} via {Enjoyment} and {Boredom}},
	abstract = {Control–Value Theory (CVT) proposes that students’ control and value appraisals shape achievement emotions, which predict learning processes. This study examined whether enjoyment and boredom were associated with the links between three control- and value-related motivational beliefs of control of learning beliefs, self-efficacy, and task value, and self-reported critical-thinking strategy use. Participants were 793 undergraduates nested within 30 courses at a university in Pakistan. Using 1-1-1 multilevel mediation models, we examined each appraisal separately and then estimated an integrated model accounting for overlap among appraisals. In separate models, task value and self-efficacy showed significant indirect associations with critical-thinking strategy use through both enjoyment and boredom, whereas control of learning beliefs showed an indirect association through enjoyment only. In the integrated model, both value-related indirect associations remained significant, as did self-efficacy–enjoyment; self-efficacy–boredom did not. Control-related pathways were model sensitive. Findings highlight differentiated emotional associations linking motivational appraisals with cognitively demanding learning strategies.},
	author = {Ashraf, Aleem},
	year = {2026},
}
