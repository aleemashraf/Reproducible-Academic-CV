
@article{ashraf_when_2026,
	title = {When {Feeling} in {Control} {Isn}’t {Enough}: {How} {Value} {Shapes} {Undergraduate} {Students}’ {Boredom}},
	volume = {7},
	issn = {2791-0202},
	shorttitle = {When {Feeling} in {Control} {Isn}’t {Enough}},
	url = {https://qjss.com.pk/index.php/qjss/article/view/610},
	doi = {10.55737/qjss.vii-v.26610},
	abstract = {Academic boredom can reduce students’ engagement, yet its antecedents remain understudied in higher education outside Western contexts. Control-Value Theory (CVT) proposes that achievement emotions arise from the interaction of appraisals of perceived control and subjective value, making their joint contribution important. This cross-sectional correlational study examined whether perceived control and subjective value independently and interactively predicted course-specific boredom among 650 undergraduate students nested in 26 courses at a private university in Karachi, Pakistan. Students completed MSLQ measures of control and value and the AEQ-R boredom subscale; self-reported GPA was included as a covariate. A mixed-effects model with random course intercepts accounted for clustering. Control negatively predicted boredom (b = −0.10, 95\% CI [−0.19, −0.02], p = .019), as did value (b = −0.35, 95\% CI [−0.41, −0.28], p \&lt; .001). Their interaction was significant but small (b = −0.05, 95\% CI [−0.10, −0.01], p = .018), indicating that subjective value was more protective when students perceived themselves to be more in control of their academic activities. Findings support CVT and suggest educators should strengthen students’ competence and coursework relevance.},
	language = {en},
	number = {5},
	urldate = {2026-11-11},
	journal = {Qlantic Journal of Social Sciences},
	author = {Ashraf, Aleem and Malik, Anila},
	month = sep,
	year = {2026},
	keywords = {Achievement Emotions, Boredom, Control-value Theory, Higher Education, Self-efficacy},
	pages = {170--182},
	file = {Full Text PDF:C\:\\Users\\Aleem Ashraf\\Zotero\\storage\\36RD7UGL\\Ashraf and Malik - 2026 - When Feeling in Control Isn’t Enough How Value Shapes Undergraduate Students’ Boredom.pdf:application/pdf},
}

